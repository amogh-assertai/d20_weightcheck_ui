# Copy this file to .env and adjust values - .env itself should NOT be committed.

FLASK_APP=run.py
FLASK_DEBUG=True

APP_NAME=Weight Check
CLIENT_NAME=Watts-Water-D20
SECRET_KEY=change-this-in-production

HOST=0.0.0.0
PORT=5000

# Expected max local CV clients connecting to this console (informational, point 2 in design brief)
MAX_CLIENTS=100

# Upload size limit in MB - relevant once ingestion endpoints are added
MAX_CONTENT_LENGTH_MB=50

# Cloud-side MongoDB (separate from the local machine's own MongoDB)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=d20_cloud